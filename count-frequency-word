import string

user_text = input("Enter the text: ")

user_text = user_text.lower()
for symbol in string.punctuation:
    user_text = user_text.replace(symbol, "")

all_words = user_text.split()

frequency_dict = {}
for single_word in all_words:
    frequency_dict[single_word] = frequency_dict.get(single_word, 0) + 1

print("\nFrequency of words:")
for unique_word, total_amount in frequency_dict.items():
    print(f"{unique_word}: {total_amount}")